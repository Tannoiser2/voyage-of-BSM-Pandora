{
  "_legend": {
    "_descr": "Snodi 'Incontro di spedizione' (regola 6.5). Per ogni snodo, regole valutate IN ORDINE: il primo cond TRUE determina il goto. Se nessuno e' TRUE -> ri-tiro Matrice di Esplorazione.",
    "terrain": "il terreno dell'esagono attualmente esplorato/occupato e' = a questo valore (chiave terrain.json canonica)",
    "terrain_or_hasty": "il terreno e' X OPPURE X e' stato attraversato durante l'ultimo movimento affrettato",
    "terrain_in": "il terreno e' uno tra la lista",
    "terrain_or_hasty_in": "il terreno (o un terreno attraversato nel mov. affrettato) e' uno tra la lista",
    "gravity": "planet_attrs.gravity e' uno tra la lista (chiavi: Near weightless/Light/Earth like/Heavy/Oppressive)",
    "atmosphere": "planet_attrs.atmosphere e' uno tra la lista (Normal/Thin/Poison/Corrosive/None)",
    "geology": "planet_attrs.geology == valore (Quiet/Active)",
    "hydro": "planet_attrs.hydro (numerico %) e' uno tra la lista",
    "climate": "INERTE: il clima non e' memorizzato; valuta SEMPRE FALSE (regola 6.5 - clima)",
    "vegetation": "l'esagono ha vegetazione (terreno Light/Heavy Vegetation)",
    "vegetation_or_hasty": "vegetazione nell'esagono o attraversata nel mov. affrettato",
    "no_vegetation": "non c'e' vegetazione (terreno != Light/Heavy Vegetation) - approssimazione 'area'",
    "landing_hex": "l'esagono esplorato e' l'esagono di atterraggio",
    "terrain_in_alias": "Alien City include 'struttura aliena' e 'citta aliena'",
    "inert": "condizione non valutabile col modello attuale (sotto-feature: stagno/fiume/sottomarino/abisso/lava fluente/stato shuttle). Valuta SEMPRE FALSE.",
    "_subfeature": "sotto-feature non modellata (combinata con altre condizioni): valuta SEMPRE FALSE",
    "robot_in_expedition": "almeno un robot e' nella spedizione (expedition_gear contiene un bot)",
    "not_immersion_underground": "la spedizione non e' in immersione ne' sottoterra: SEMPRE TRUE col modello attuale",
    "unexplored_alien_city_in_area": "esiste un esagono Alien City non esplorato nell'area",
    "lava_in_area": "INERTE: 'lava fusa che scorre' nell'area non modellata -> FALSE",
    "climate_not": "INERTE come climate -> FALSE",
    "all": "AND di tutte le condizioni elencate"
  },
